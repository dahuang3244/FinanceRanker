# FinanceRanker configuration — copy to `.env` and edit.
# Every value is optional; the defaults work out of the box.

# ---------- server ----------
FR_HOST=127.0.0.1
FR_PORT=8848

# ---------- networking ----------
# Leave empty to use the OS/environment proxy (macOS system proxy included).
#   "http://127.0.0.1:7897" -> force a specific proxy
#   "direct"                -> bypass every proxy
# If a proxy is configured but not running you will see ProxyError; use "direct".
FR_PROXY=
FR_HTTP_TIMEOUT=25
FR_MAX_RETRIES=4
# Politeness delay between requests to free public endpoints (seconds).
FR_REQUEST_DELAY=0.15
# Parallel tickers. 4-8 is a good balance for free endpoints.
FR_MAX_CONCURRENCY=6

# SEC fair-access policy requires a descriptive User-Agent with a contact.
FR_SEC_USER_AGENT=FinanceRanker/1.0 (research; contact@example.com)

# ---------- providers ----------
# Yahoo blocks datacenter / mainland-China egress. Enable only behind a working
# proxy or on an overseas host; it is used as a fallback, never as the default.
FR_ENABLE_YAHOO=false
# auto = use Yahoo only when the startup probe reaches it
FR_YAHOO_MODE=auto
FR_ENABLE_AKSHARE=true

# ---------- cache TTLs (seconds) ----------
FR_CACHE_TTL_PRICE=21600
FR_CACHE_TTL_QUOTE=300
FR_CACHE_TTL_FUNDAMENTALS=43200
FR_CACHE_TTL_SECMAP=86400

# ---------- default universe ----------
FR_DEFAULT_TICKERS=MSFT,AAPL,GOOGL,AMZN,META,NVDA,TSM,AMD,QCOM,AVGO,AMAT,MU,ORCL

# ---------- scoring weights (must sum to 1) ----------
FR_W_GROWTH=0.25
FR_W_PROFITABILITY=0.25
FR_W_CASH=0.20
FR_W_VALUATION=0.20
FR_W_MARKET=0.10

# ---------- scheduled auto-refresh ----------
# Set exactly one of these.
#   FR_SCHEDULE_HOURS=6           -> refresh every 6 hours
#   FR_SCHEDULE_CRON=0 22 * * 1-5 -> weekdays 22:00 local time
FR_SCHEDULE_HOURS=0
FR_SCHEDULE_CRON=

# ---------- packaged app ----------
# Override where snapshots/cache/logs are written (defaults to the per-user dir)
# FR_DATA_DIR=
